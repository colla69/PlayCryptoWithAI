# ── Live server environment ────────────────────────────────────────────────────
# Copy this file to .env.live on your server and fill in real values.
# This file is in .gitignore — NEVER commit real keys.
# Every variable the bot reads is listed here; README.md § Environment Variables describes them.

BINANCE_API_KEY=your_real_api_key
BINANCE_API_SECRET=your_real_api_secret

# Set false only when you are ready to trade real funds
PAPER_MODE=true

# Set false only after thorough paper testing
BINANCE_TESTNET=false

# ── Strategy switches (both off unless set to exactly "true") ──────────────────
# With PAPER_MODE=false each of these places REAL orders.
# TSM majors trend sleeve
TSM_CORE=false
# Satellite strategies on the free cash (4h breakout; see config.satellites)
SATELLITES=false

DASHBOARD_PORT=3001
WEBHOOK_PORT=3000
# The external-signal webhook is off by default and refuses to start without a token.
WEBHOOK_TOKEN=

LOG_LEVEL=info
# CONSOLE_LOG_LEVEL=info
# FILE_LOG_LEVEL=debug

# false = skip the startup connectivity check
SMOKE_TEST=true

# Optional: Telegram notifications
TELEGRAM_TOKEN=
TELEGRAM_CHANNEL_IDS=

# Optional: signal sources
TWITTER_BEARER_TOKEN=
LEADER_API_KEY=
LEADER_API_SECRET=

# Root for bot state (data/ state files, logs/). Default: the working directory.
# PLAYCRYPTO_RUNTIME_DIR=
