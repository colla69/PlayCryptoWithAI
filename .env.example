# ── Local environment ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. .env is in .gitignore — NEVER commit real keys.
# Every variable the bot reads is listed here; README.md § Environment Variables describes them.

# ── Exchange ───────────────────────────────────────────────────────────────────
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
# true = Binance testnet endpoints
BINANCE_TESTNET=true
# true = simulate, no orders. The bot also falls back to paper when a key is missing.
PAPER_MODE=false

# ── Strategy switches (both off unless set to exactly "true") ──────────────────
# TSM majors trend sleeve. Simulated in paper mode; REAL orders in live mode.
TSM_CORE=false
# Satellite strategies on the free cash (4h breakout; see config.satellites).
# Simulated in paper mode; REAL orders in live mode.
SATELLITES=false

# ── Ports ──────────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3001
WEBHOOK_PORT=3000
# The external-signal webhook is off by default and refuses to start without a token.
# Requests must send it in the x-webhook-token header.
WEBHOOK_TOKEN=

# ── Notifications and signal sources (optional) ────────────────────────────────
TELEGRAM_TOKEN=
# Comma-separated chat IDs
TELEGRAM_CHANNEL_IDS=
TWITTER_BEARER_TOKEN=
LEADER_API_KEY=
LEADER_API_SECRET=

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Console level; falls back to LOG_LEVEL when unset
# CONSOLE_LOG_LEVEL=info
# File level (logs/app-YYYY-MM-DD.log)
# FILE_LOG_LEVEL=debug

# ── Runtime ────────────────────────────────────────────────────────────────────
# false = skip the startup connectivity check
SMOKE_TEST=true
# Root for bot state (data/ state files, logs/). Default: the working directory.
# Set it to a temp dir for any local run next to a live container that mounts this checkout.
# PLAYCRYPTO_RUNTIME_DIR=
